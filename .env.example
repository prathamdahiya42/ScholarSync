# Local Database
DATABASE_URL="file:./dev.db"

# Security & Encryption (32-byte hex for AES-256)
BANK_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
SESSION_SECRET="super-secret-dev-session-token-32-chars-long!"

# AI & OCR Configuration
# Options: tesseract | gemini | mock
OCR_PROVIDER="tesseract"

# Options: regex | gemini | mock
EXTRACTOR_PROVIDER="regex"

# Security gate for external third-party AI APIs (must be true to call Gemini)
ALLOW_EXTERNAL_AI="false"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Storage Configuration
# Options: local | supabase
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./uploads/documents"

# Notification Configuration
# Options: mock | whatsapp_cloud | sms_msg91 | sms_twilio
NOTIFY_PROVIDER="mock"

# WhatsApp Cloud API (when NOTIFY_PROVIDER=whatsapp_cloud)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# SMS DLT (when NOTIFY_PROVIDER=sms_msg91 or sms_twilio)
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_DLT_ENTITY_ID=""

# OTP Provider
# Options: mock | sms_msg91 | sms_twilio
# Mock OTP code accepted in dev: 123456
OTP_PROVIDER="mock"
